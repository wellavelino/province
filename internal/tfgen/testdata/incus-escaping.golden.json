{
  "terraform": {
    "required_providers": {
      "incus": {
        "source": "lxc/incus",
        "version": "1.2.1"
      }
    }
  },
  "provider": {
    "incus": {}
  },
  "resource": {
    "incus_instance": {
      "env": {
        "name": "demo",
        "description": "Managed by province (env demo)",
        "remote": "box$${path.root}%%{endif}",
        "project": "dev$${path.root}%%{endif}",
        "image": "images:debian/13$${path.root}%%{endif}",
        "type": "container",
        "running": true,
        "config": {
          "boot.autostart": "true",
          "limits.cpu": "2",
          "limits.memory": "2048MiB",
          "user.province.env": "demo"
        },
        "device": [
          {
            "name": "root",
            "type": "disk",
            "properties": {
              "path": "/",
              "pool": "default$${path.root}%%{endif}",
              "size": "16GiB"
            }
          },
          {
            "name": "eth0",
            "type": "nic",
            "properties": {
              "name": "eth0",
              "network": "incusbr0$${path.root}%%{endif}"
            }
          }
        ]
      }
    }
  },
  "output": {
    "name": {
      "value": "${incus_instance.env.name}"
    }
  }
}
